---
import '../index.css';

interface Props {
  title?: string;
}

const siteTitle = 'Afrilink Corp';
const { title } = Astro.props;
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
// Favicons live in public/; prefix with the base path so they resolve on GitHub Pages too
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Corporation',
  name: 'Afrilink Corporation (Pty) Ltd',
  alternateName: 'Afrilink Group',
  slogan: 'Making Diaspora Work',
  description: 'South African investment holding company committed to broad-based economic empowerment, sustainable business growth and strategic partnerships across South Africa and the African continent.',
  founder: {
    '@type': 'Person',
    name: 'Dr Molefe M.D. Mokgatle',
    jobTitle: 'Founder, Chairman & Chief Executive Officer',
  },
  areaServed: ['South Africa', 'Botswana', 'Sub-Saharan Africa'],
  knowsAbout: ['Mining & Commodities', 'Resources & Infrastructure', 'Financial Services', 'Strategic Ventures & Digital Tech'],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta name="theme-color" content="#0B1022" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content="Afrilink Corporation is a premier South African investment holding company driving economic empowerment, mining, infrastructure, technology and diaspora capital across South Africa and Botswana. Tagline: Making Diaspora Work." />
    <meta name="keywords" content="investment holding company South Africa, African investment partner, B-BBEE investment company, Botswana mining investment, diaspora investment Africa, Dr Molefe Mokgatle, strategic ventures" />
    <meta name="author" content="Afrilink Corporation (Pty) Ltd" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="AFRILINK CORPORATION | Making Diaspora Work" />
    <meta property="og:description" content="Strategic investments and partnerships driving empowerment, strict governance and sustainable value across South Africa and the African continent." />
    <meta property="og:site_name" content="Afrilink Corporation" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="AFRILINK CORPORATION | Making Diaspora Work" />
    <meta name="twitter:description" content="Strategic investments driving empowerment, governance and sustainable value in South Africa & Botswana." />

    <!-- Google Fonts: Plus Jakarta Sans (matches afrilinkbuilding.co.za) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />

    <!-- Structured Data: Organization Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body class="bg-afrilink-surface text-afrilink-fg font-sans antialiased">
    <slot />
  </body>
</html>
